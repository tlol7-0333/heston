generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USUARIO
  EMPRESA
}

model User {
  id            String        @id @default(cuid())
  name          String
  username      String
  email         String        @unique
  phone         String
  passwordHash  String
  role          Role          @default(USUARIO)
  headline      String?
  bio           String?
  location      String?
  createdAt     DateTime      @default(now())

  opportunities Opportunity[]
  applications  Application[]
  posts         Post[]
}

model Opportunity {
  id           String        @id @default(cuid())
  title        String
  companyName  String
  category     String
  description  String
  location     String
  salaryInfo   String?
  cardGradient String
  companyId    String
  company      User          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  applications Application[]
}

model Application {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     User        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, candidateId])
}

model Post {
  id          String   @id @default(cuid())
  content     String
  title       String?
  isFlashcard Boolean  @default(false)
  cardColor   String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
